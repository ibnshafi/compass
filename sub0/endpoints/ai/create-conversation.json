{
  "id": "ai-conversations-create-01",
  "resource": "ai/conversations/create",
  "tokenize": {
    "type": "JWT",
    "algorithm": "HS256",
    "encryption_key": "$ENV.JWT_KEY"
  },
  "protected": {
    "provide_as": "Authorization",
    "extract_claims": ["id"]
  },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "sql_query": {
        "query": "INSERT INTO _ai_conversation (id, title, messages, userId, createdAt, updatedAt) VALUES ($1, $2, $3, $4, $5, $6)",
        "parameters": ["$GENERATE_UUID", "title", "messages", "$PROTECTED.id", "$DATETIME", "$DATETIME"]
      }
    }
  ],
  "returnables": ["*"]
}
