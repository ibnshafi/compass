{
  "id": "user-profile-01",
  "resource": "auth/profile",
  "tokenize": {
    "type": "JWT",
    "algorithm": "HS256",
    "encryption_key": "$ENV.JWT_KEY"
  },
  "protected": {
    "provide_as": "Authorization",
    "extract_claims": ["id"]
  },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "sql_query": {
        "query": "SELECT id, clerkId, email, firstName, lastName, role, avatarUrl, phoneNumber, createdAt FROM _user WHERE id = $1 AND deletedAt IS NULL",
        "parameters": ["$PROTECTED.id"]
      }
    }
  ],
  "returnables": ["ignore:password"]
}
