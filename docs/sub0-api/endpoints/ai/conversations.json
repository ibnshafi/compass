{
  "id": "ai-conversations-list-01",
  "resource": "ai/conversations",
  "tokenize": {
    "type": "JWT",
    "algorithm": "HS256",
    "encryption_key": "$ENV.JWT_KEY"
  },
  "protected": {
    "provide_as": "Authorization",
    "extract_claims": ["id"]
  },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "sql_query": {
        "query": "SELECT id, title, createdAt, updatedAt FROM _ai_conversation WHERE userId = $1 ORDER BY updatedAt DESC",
        "parameters": ["$PROTECTED.id"]
      }
    }
  ],
  "returnables": ["*"]
}
